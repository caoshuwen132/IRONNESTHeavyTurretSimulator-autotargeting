<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IronNestFCS.Installer</RootNamespace>
    <AssemblyName>IronNestFCS-单文件安装器</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Content Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\MelonLoader.x64.zip"><LogicalName>IronNestFCS.Payload.MelonLoader.x64.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\UnityDependencies_6000.3.9.zip"><LogicalName>IronNestFCS.Payload.UnityDependencies_6000.3.9.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\UnityDependencies_6000.3.21.zip"><LogicalName>IronNestFCS.Payload.UnityDependencies_6000.3.21.zip</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\Cpp2IL.exe"><LogicalName>IronNestFCS.Payload.Cpp2IL.exe</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\Cpp2IL.Plugin.StrippedCodeRegSupport.dll"><LogicalName>IronNestFCS.Payload.Cpp2IL.Plugin.StrippedCodeRegSupport.dll</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\Mods\IronNestFCS.dll"><LogicalName>IronNestFCS.Payload.Mods.IronNestFCS.dll</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\UserLibs\IronNestFCS.Abstractions.dll"><LogicalName>IronNestFCS.Payload.UserLibs.IronNestFCS.Abstractions.dll</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="Payload\UserData\IronNestFCS\IronNestFCS.Logic.dll"><LogicalName>IronNestFCS.Payload.UserData.IronNestFCS.IronNestFCS.Logic.dll</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
